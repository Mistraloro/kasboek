    {"op": "insights.feedback", "input": {"key": "d", "verdict": "useful"}},
    {"op": "insights.restoreDismissed"},
    {"op": "insights.restoreDismissed"},
    {"op": "insights.feedback", "input": {"key": "a", "verdict": "dismissed"}},
    {"op": "insights.feedback", "input": {"key": "a", "verdict": "dismissed"}},
    {"op": "insights.restoreDismissed"}
  ]
