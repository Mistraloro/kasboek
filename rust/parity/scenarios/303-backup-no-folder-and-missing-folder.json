      "input": {
        "name": "kasboek-backup-2026-11-14_100000.kasboek"
      }
    },
    {
      "op": "backup.revealFolder"
    },
    {
      "op": "backup.chooseFolder"
    },
    {
      "op": "backup.runNow"
    },
    {
      "op": "backup.list"
    },
    {
      "op": "backup.pick",
      "input": {
        "name": "kasboek-backup-2026-11-14_100000.kasboek"
      }
    },
    {
      "op": "backup.configureAuto",
      "input": {
        "enabled": true
