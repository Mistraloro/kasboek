{
  "name": "retention on a moving clock: everything of the last day, the newest per day for 30 days, the newest per month for a year; older ones are deleted at each run",
  "service": true,
  "dialogs": [
    "$tmp"
  ],
  "steps": [
    {
      "op": "backup.chooseFolder"
    },
    {
      "op": "@clock",
      "input": {
        "at": "2025-09-20T08:00:00Z"
      }
    },
    {
      "op": "backup.runNow"
    },
    {
