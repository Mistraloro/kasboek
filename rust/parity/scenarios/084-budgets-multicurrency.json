{
  "name": "budgets: spending in other currencies is converted at the date of each payment, missing rates are left out",
  "steps": [
    {"op":"accounts.create","input":{"name":"Main"}},
    {"op":"accounts.create","input":{"name":"Dollar","currency":"USD"}},
    {"op":"accounts.create","input":{"name":"Krona","currency":"SEK"}},
    {"op":"@sql","input":{"sql":"INSERT INTO fx_rates (currency, date, per_eur, source) VALUES ('USD','2026-10-01',1.1,'ecb'),('USD','2026-10-15',1.2,'ecb'),('USD','2026-10-15',1.25,'manual')"}},
    {"op":"@fxReload"},
    {"op":"@sql","input":{"sql":"SELECT 1"}},
    {"op":"budgets.set","input":{"categoryId":3,"month":"2026-10","amountCents":5000}},
    {"op":"transactions.create","input":{"accountId":1,"bookingDate":"2026-10-01","amountCents":-1000,"description":"EUR","categoryId":3}},
    {"op":"transactions.create","input":{"accountId":2,"bookingDate":"2026-10-01","amountCents":-1100,"description":"USD early","categoryId":3}},
    {"op":"transactions.create","input":{"accountId":2,"bookingDate":"2026-10-20","amountCents":-1250,"description":"USD late","categoryId":3}},
    {"op":"transactions.create","input":{"accountId":3,"bookingDate":"2026-10-20","amountCents":-5000,"description":"SEK no rate","categoryId":3}},
    {"op":"budgets.list","input":{"month":"2026-10"}},
    {"op":"summary.month","input":{"month":"2026-10"}}
  ]
}
