    {"op":"transactions.create","input":{"accountId":1,"bookingDate":"2026-10-10","amountCents":-20000,"description":"To dollars 2"}},
    {"op":"transactions.create","input":{"accountId":3,"bookingDate":"2026-10-10","amountCents":21000,"description":"Dollars 2"}},
