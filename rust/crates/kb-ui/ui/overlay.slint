// Things that float: Select (dropdown), Popover, MonthNav, Modal, Toast host, Tip (hover card) and HoverTip.
import { Theme, Elevated } from "theme.slint";
import { Icon, Label, PressTarget, Pressable, FocusRing } from "base.slint";
import { Icons } from "icons.slint";
import { Button, IconButton } from "button.slint";
import { ListView, Scrollbar } from "data.slint";
import { Rules } from "rules.slint";
import { UiText } from "texts.slint";

// Panel look shared by the dropdown, the month picker and popovers: `rounded-xl border bg-surface shadow-lg`.
export component PanelFrame inherits Elevated {
    in property <length> radius: Theme.r-xl;
    level: 3;
    border-radius: root.radius;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
}

// A popup window that closes on a click outside or Escape. Position it with x/y relative to its parent and call
// `open()`. Slint gives the popup the keyboard focus while it is shown and hands it back on close.
export component Popover inherits PopupWindow {
    in property <string> label;
    public function open() {
        self.show();
    }
    close-policy: close-on-click-outside;

    scope := FocusScope {
        init => {
            self.focus();
        }
        accessible-role: groupbox;
        accessible-label: root.label;
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.close();
                return accept;
            }
            return reject;
        }
        PanelFrame {
            @children
        }
    }
}

// The card of charts.tsx `Tip` and of tooltips: `rounded-lg border bg-surface px-3 py-2 text-xs shadow-lg`.
// Children are the lines; the card sizes itself to them.
export component Tip inherits Elevated {
    level: 3;
    border-radius: Theme.r-lg;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    width: col.preferred-width + 24px + 2px;
    height: col.preferred-height + 16px + 2px;
    col := VerticalLayout {
        x: 13px;
        y: 9px;
        width: parent.width - 26px;
        @children
    }
}

// Hover tooltip for any element: place it inside the element (it expands over its parent). The renderer uses the
// browser's `title` attribute; this is the same words with our card. The element it sits in must still carry the
// accessible name or description: the tooltip text is only for the pointer.
export component HoverTip inherits Rectangle {
    in property <string> text;
    Tooltip {
        Tip {
            Label {
                text: root.text;
                font-size: Theme.fs-tip;
                lh: Theme.lh-xs;
                accessible-role: none;
            }
        }
    }
}

component SelectRow inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> highlighted;
    callback clicked();
    height: 32px;
    border-radius: Theme.r-md;
    background: root.highlighted ? Theme.surface-2 : transparent;

    Label {
        x: 8px;
        width: parent.width - 16px - 20px;
        text: root.text;
        font-weight: root.selected ? 500 : 400;
        overflow: elide;
        accessible-role: none;
    }
    if root.selected: Icon {
        x: parent.width - 8px - 16px;
        y: (parent.height - 16px) / 2;
        source: Icons.check;
        size: 16px;
        tint: Theme.accent;
    }
    TouchArea {
        accessible-role: list-item;
        accessible-label: root.text;
        accessible-item-selectable: true;
        accessible-item-selected: root.selected;
        accessible-action-default => {
            root.clicked();
        }
        clicked => {
            root.clicked();
        }
    }
}

// `Select` of ui.tsx: `control pr-8`, with a dropdown list of our own (the renderer's is the browser's). Keys: on the
// closed control Up/Down/Home/End change the value, typing a letter jumps to the next item that starts with what was
// typed, Space/Enter/Alt+Down open the list; in the list Up/Down/Home/End move, Enter picks, Escape closes (focus
// returns to the control), typing jumps. The list scrolls (ListView) after 8 items.
export component Select inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: -1;
    in property <string> placeholder: UiText.select-placeholder;
    in property <string> label;
    in property <string> description;
    in property <bool> enabled: true;
    in property <bool> invalid: false;
    // "focus", "open" (gallery shots).
    in property <string> simulate;
    callback selected(int);
    out property <bool> open: popup.is-open;
    forward-focus: trigger;

    property <int> hl: 0;
    property <length> list-y: 0px;
    property <length> list-content-h: root.model.length * 32px;
    property <string> typed;
    property <int> rows: min(root.model.length, 8);
    property <string> current-text: (root.current-index >= 0 && root.current-index < root.model.length) ? root.model[root.current-index] : "";
    property <bool> focused: trigger.has-focus || root.simulate == "focus" || root.simulate == "open";

    function choose(i: int) {
        if (i >= 0 && i < root.model.length && i != root.current-index) {
            root.current-index = i;
            root.selected(i);
        }
    }
    function open-list() {
        root.hl = max(root.current-index, 0);
        root.list-y = -clamp((root.hl - 3) * 32px, 0px, max(root.model.length * 32px - root.rows * 32px, 0px));
        popup.show();
    }
    function jump(ch: string, from: int) -> int {
        root.typed = root.typed + ch.to-lowercase();
        forget.running = false;
        forget.running = true;
        return Rules.find-prefix(root.model, root.typed, from);
    }
    // Keeps the highlighted row inside the visible window of the list.
    function reveal() {
        if (root.hl * 32px < -root.list-y) {
            root.list-y = -root.hl * 32px;
        } else if ((root.hl + 1) * 32px > -root.list-y + root.rows * 32px) {
            root.list-y = -((root.hl + 1) * 32px - root.rows * 32px);
        }
    }

    height: Theme.h-control;
    border-radius: root.focused ? Theme.r-md : Theme.r-lg;
    border-width: 1px;
    border-color: root.focused ? Theme.accent : root.invalid ? Theme.negative : Theme.border;
    background: Theme.surface;
    opacity: root.enabled ? 1 : 0.6;

    forget := Timer {
        interval: 800ms;
        running: false;
        triggered => {
            root.typed = "";
            self.running = false;
        }
    }
    Label {
        x: 13px;
        y: 1px;
        width: parent.width - 13px - 32px;
        height: parent.height - 1px;
        text: root.current-index >= 0 ? root.current-text : root.placeholder;
        color: root.current-index >= 0 ? Theme.text : Theme.muted.with-alpha(0.7);
        overflow: elide;
        accessible-role: none;
    }
    Icon {
        x: parent.width - 12px - 16px;
        y: (parent.height - 16px) / 2;
        source: Icons.chevron-down;
        size: 16px;
        tint: Theme.muted;
    }
    trigger := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        accessible-role: combobox;
        accessible-label: root.label;
        accessible-description: root.description;
        accessible-enabled: root.enabled;
        accessible-expanded: root.open;
        accessible-value: root.current-text;
        accessible-action-default => {
            root.open-list();
        }
        accessible-action-expand => {
            root.open-list();
        }
        key-pressed(e) => {
            if (e.text == Key.DownArrow && e.modifiers.alt) {
                root.open-list();
                return accept;
            }
            if (e.text == Key.DownArrow) {
                root.choose(min(root.current-index + 1, root.model.length - 1));
                return accept;
            }
            if (e.text == Key.UpArrow) {
                root.choose(max(root.current-index - 1, 0));
                return accept;
            }
            if (e.text == Key.Home) {
                root.choose(0);
                return accept;
            }
            if (e.text == Key.End) {
                root.choose(root.model.length - 1);
                return accept;
            }
            if (e.text == Key.Return || (e.text == " " && root.typed == "")) {
                root.open-list();
                return accept;
            }
            if (e.text.character-count == 1 && !e.modifiers.control && !e.modifiers.meta && e.text != Key.Escape && e.text != Key.Tab && e.text != Key.Backtab) {
                root.choose(root.jump(e.text, root.current-index + 1));
                return accept;
            }
            return reject;
        }
        TouchArea {
            enabled: root.enabled;
            clicked => {
                root.open-list();
            }
        }
        if self.has-focus && root.enabled: FocusRing {
            radius: 8px;
            gap: 1px;
        }
    }
    if root.simulate == "focus" && root.enabled: FocusRing {
        radius: 8px;
        gap: 1px;
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: root.rows * 32px + 10px;
        close-policy: close-on-click-outside;

        pop-scope := FocusScope {
            init => {
                self.focus();
            }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    popup.close();
                    return accept;
                }
                if (e.text == Key.DownArrow) {
                    root.hl = min(root.hl + 1, root.model.length - 1);
                    root.reveal();
                    return accept;
                }
                if (e.text == Key.UpArrow) {
                    root.hl = max(root.hl - 1, 0);
                    root.reveal();
                    return accept;
                }
                if (e.text == Key.Home) {
                    root.hl = 0;
                    root.reveal();
                    return accept;
                }
                if (e.text == Key.End) {
                    root.hl = root.model.length - 1;
                    root.reveal();
                    return accept;
                }
                if (e.text == Key.Return || (e.text == " " && root.typed == "")) {
                    root.choose(root.hl);
                    popup.close();
                    return accept;
                }
                if (e.text.character-count == 1 && !e.modifiers.control && !e.modifiers.meta && e.text != Key.Tab && e.text != Key.Backtab) {
                    let at = root.jump(e.text, root.hl + 1);
                    if (at >= 0) {
                        root.hl = at;
                        root.reveal();
                    }
                    return accept;
                }
                return reject;
            }
            PanelFrame {
                radius: Theme.r-lg;
                list := ListView {
                    x: 5px;
                    y: 5px;
                    width: parent.width - 10px - 10px;
                    height: root.rows * 32px;
                    content-y <=> root.list-y;
                    for item[i] in root.model: SelectRow {
                        text: item;
                        selected: i == root.current-index;
                        highlighted: i == root.hl;
                        clicked => {
                            root.choose(i);
                            popup.close();
                        }
                    }
                }
                Scrollbar {
                    x: parent.width - self.width - 1px;
                    y: 5px;
                    height: root.rows * 32px;
                    content-height: root.list-content-h;
                    visible-height: root.rows * 32px;
                    content-y <=> root.list-y;
                }
            }
        }
    }
    if root.simulate == "open": Rectangle {
        // Shot only: the dropdown drawn in place (a popup cannot be open in a still image of one component).
        y: root.height + 4px;
        width: root.width;
        height: root.rows * 32px + 10px;
        PanelFrame {
            radius: Theme.r-lg;
            VerticalLayout {
                padding: 5px;
                for item[i] in root.model: SelectRow {
                    text: item;
                    selected: i == root.current-index;
                    highlighted: i == root.hl;
                }
            }
        }
    }
}
