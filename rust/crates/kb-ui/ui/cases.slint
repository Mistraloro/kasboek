}

export component CaseSegmented inherits CaseFrame {
    width: 480px;
    height: 216px;
    Segmented {
        x: 24px;
        y: 24px;
        label: "Period";
        options: [{ label: "Month" }, { label: "Year" }];
        current-index: 0;
    }
    Segmented {
        x: 24px;
        y: 72px;
        label: "Theme";
        options: [{ label: "System", icon: Icons.monitor, has-icon: true }, { label: "Light", icon: Icons.sun, has-icon: true }, { label: "Dark", icon: Icons.moon, has-icon: true }];
        current-index: 1;
    }
    Segmented {
        x: 24px;
        y: 120px;
        label: "Mode";
        options: [{ label: "Income" }, { label: "Spending" }, { label: "Both", disabled: true }];
        current-index: 1;
        simulate: "focus";
    }
}

