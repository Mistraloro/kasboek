export component CaseCard inherits CaseFrame {
    width: 640px;
    height: 224px;
    Card {
        x: 24px;
        y: 24px;
        width: 592px;
        height: col.preferred-height + 2px;
        col := VerticalLayout {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            CardHeader {
                title: "Budget progress";
                description: "Spent this month against your limits";
                Button {
                    text: "Edit";
                    small: true;
                }
            }
            Rectangle {
                height: 20px + 19.5px + 20px;
                Label {
                    x: 20px;
                    y: 20px;
                    width: parent.width - 40px;
                    height: 19.5px;
                    text: "Groceries are at 84% of the budget.";
                    font-size: Theme.fs-ui;
                    lh: 19.5px;
                }
            }
        }
    }
}

export component CasePageHeader inherits CaseFrame {
    width: 800px;
    height: 120px;
    PageHeader {
        x: 24px;
        y: 24px;
        width: 752px;
        title: "Overview";
        subtitle: "March 2026";
        Button {
            text: "Import";
            variant: "primary";
        }
    }
}

export component CaseEmptyState inherits CaseFrame {
    width: 640px;
    height: 296px;
    Card {
        x: 24px;
        y: 24px;
        width: 592px;
        height: 248px;
        EmptyState {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            icon: Icons.arrow-left-right;
            title: "No transactions yet";
            body: "Import a bank file or add a transaction by hand to see it here.";
            has-action: true;
            Button {
                text: "Go to import";
                variant: "primary";
            }
        }
    }
}

export component CaseModal inherits CaseFrame {
    width: 640px;
    height: 420px;
    Label {
        x: 40px;
        y: 40px;
        text: "Page behind the dialog";
        color: Theme.muted;
    }
    Modal {
        open: true;
        demo: true;
        title: "Add a note";
        Field {
            label: "Note";
            hint: "Only you can see it.";
            Input {
                label: "Note";
                text: "Rent for March";
            }
        }
        Rectangle {
            height: 16px;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button {
                text: "Cancel";
            }
            Button {
                text: "Save";
                variant: "primary";
            }
        }
    }
}

export component CaseModalAsk inherits CaseFrame {
    width: 640px;
    height: 420px;
    Modal {
        open: true;
        demo: true;
        title: "Add a note";
        force-asking: true;
        dirty: true;
        Rectangle {
            height: 40px;
        }
    }
}

export component CaseMonthNav inherits CaseFrame {
    width: 640px;
    height: 360px;
    MonthNav {
        x: 24px;
        y: 24px;
        year: 2026;
        month: 3;
        label: "March 2026";
        month-names: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        today-year: 2026;
        today-month: 3;
        force-open: true;
    }
}

export component CaseToast inherits CaseFrame {
    width: 640px;
    height: 200px;
    ToastHost {
        width: parent.width;
        height: parent.height;
        toasts: [{ id: 1, tone: "success", message: "Copied to the clipboard." }, { id: 2, tone: "error", message: "The backup could not be written: the folder is read-only." }];
    }
}

