// The gallery's cases: one component per design-system component (or small family), each with a fixed size and
// absolute positions, laid out exactly like its twin in tools/reference/harness.tsx so that the parity script can
// compare them. Sizes live in tools/cases.json. States are forced with `simulate`.
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { Icon, Label } from "base.slint";
import { Button, IconButton } from "button.slint";
import { Card, CardHeader, PageHeader, Badge, EmptyState } from "surface.slint";
import { Field, Input, PasswordInput, CodeInput, Switch, Checkbox, RadioGroup, Segmented, SegmentOption } from "form.slint";
import { Select, Tip, HoverTip, Popover } from "overlay.slint";
import { Modal, ConfirmDialog, ToastHost, ToastItem } from "dialog.slint";
import { MonthNav, DateInput } from "month.slint";
import { ListView, Scrollbar, Tabs, TableRow, TableCell } from "data.slint";
import { Meter, ProgressBar, Spinner } from "progress.slint";
import { CategoryBars, MonthBars, TrendLine, CategoryBar, MonthDatum, TrendPoint } from "charts.slint";

component CaseFrame inherits Rectangle {
    background: Theme.bg;
}

export component CaseButton inherits CaseFrame {
    width: 640px;
    height: 272px;
    for variant[r] in ["primary", "secondary", "ghost", "danger"]: Rectangle {
        y: 24px + r * 48px;
        height: 36px;
        Button {
            x: 24px;
            y: 0px;
            text: "Save";
            variant: variant;
        }
        Button {
            x: 184px;
            y: 0px;
            text: "Save";
            variant: variant;
            simulate: "hover";
        }
        Button {
            x: 344px;
            y: 0px;
            text: "Save";
            variant: variant;
            simulate: "focus";
        }
        Button {
            x: 504px;
            y: 0px;
            text: "Save";
            variant: variant;
            enabled: false;
        }
    }
    Button {
        x: 24px;
        y: 216px;
        text: "Edit";
        small: true;
    }
    Button {
        x: 184px;
        y: 216px;
        text: "Copy";
        icon: Icons.copy;
        has-icon: true;
    }
    Button {
        x: 344px;
        y: 216px;
        text: "Add account";
        variant: "primary";
        icon: Icons.plus;
        has-icon: true;
    }
}

export component CaseInput inherits CaseFrame {
