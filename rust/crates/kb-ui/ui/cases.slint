export component CaseCategoryBars inherits CaseFrame {
    width: 640px;
    height: 300px;
    Card {
        x: 24px;
        y: 24px;
        width: 592px;
        height: col.preferred-height + 2px;
        col := VerticalLayout {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            padding: 20px;
            CategoryBars {
                top: 54200;
                rows: [{ name: "Groceries", cents: 54200, value: "€542.00" }, { name: "Rent", cents: 50000, value: "€500.00" }, { name: "Dining out", cents: 18950, value: "€189.50" }, { name: "Transport", cents: 9400, value: "€94.00" }, { name: "Subscriptions", cents: 4599, value: "€45.99" }, { name: "Other", cents: 300, value: "€3.00" }];
            }
        }
    }
}

export component CaseMonthBars inherits CaseFrame {
    width: 640px;
    height: 320px;
    in property <int> hover: -1;
    Card {
        x: 24px;
        y: 24px;
        width: 592px;
        height: col.preferred-height + 2px;
        col := VerticalLayout {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            padding: 20px;
            MonthBars {
                top: 310000;
                hover: root.hover;
                label: "Income and spending per month";
                summary: "Jan: income 2,450.00, spending 1,890.00";
                income-legend: "Income";
                spending-legend: "Spending";
                data: [{ label: "Oct", income: 245000, spending: 189000, income-text: "€2,450.00", spending-text: "€1,890.00" }, { label: "Nov", income: 245000, spending: 210500, income-text: "€2,450.00", spending-text: "€2,105.00" }, { label: "Dec", income: 310000, spending: 267300, income-text: "€3,100.00", spending-text: "€2,673.00" }, { label: "Jan", income: 245000, spending: 176000, income-text: "€2,450.00", spending-text: "€1,760.00" }, { label: "Feb", income: 245000, spending: 0, income-text: "€2,450.00", spending-text: "€0.00" }, { label: "Mar", income: 0, spending: 54200, income-text: "€0.00", spending-text: "€542.00" }];
            }
        }
    }
}

export component CaseTrendLine inherits CaseFrame {
    width: 640px;
    height: 320px;
    in property <int> hover: -1;
    Card {
        x: 24px;
        y: 24px;
        width: 592px;
        height: col.preferred-height + 2px;
        col := VerticalLayout {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            padding: 20px;
            TrendLine {
                hover: root.hover;
                lo: -48000;
                hi: 1272000;
                ticks: [0, 500000, 1000000];
                tick-texts: ["0", "5k", "10k"];
                label: "Net worth over time";
                summary: "Jan: 2,500.00";
                data: [{ label: "Jan", cents: 0, value: "€0.00", note: "" }, { label: "Feb", cents: 250000, value: "€2,500.00", note: "" }, { label: "Mar", cents: 410000, value: "€4,100.00", note: "Bonus" }, { label: "Apr", cents: 380000, value: "€3,800.00", note: "" }, { label: "May", cents: 720000, value: "€7,200.00", note: "" }, { label: "Jun", cents: 900000, value: "€9,000.00", note: "" }, { label: "Jul", cents: 1200000, value: "€12,000.00", note: "" }];
            }
        }
    }
}

export component CaseDate inherits CaseFrame {
    width: 480px;
    height: 120px;
    DateInput {
        x: 24px;
        y: 24px;
        width: 432px;
        label: "Date";
        example: "2026-03-15";
    }
    // Somewhere for Tab to go, so that the field can lose focus in a still (out of view, like the page behind it).
    Button {
        x: 24px;
        y: 200px;
        text: "Next";
    }
}
