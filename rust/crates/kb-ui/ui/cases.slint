    }
    Input {
        x: 24px;
        y: 168px;
        width: 432px;
        text: "Groceries";
        label: "Description";
        enabled: false;
    }
    Input {
        x: 24px;
        y: 216px;
        width: 432px;
        text: "-1234,50";
        label: "Amount";
        numeric: true;
        invalid: true;
    }
}

