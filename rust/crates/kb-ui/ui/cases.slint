    Select {
        x: 24px;
        y: 24px;
        width: 432px;
        model: ["Euro", "US dollar", "Pound sterling"];
        current-index: 0;
        label: "Currency";
    }
    Select {
        x: 24px;
        y: 72px;
        width: 432px;
        model: ["Euro", "US dollar", "Pound sterling"];
        current-index: 1;
        label: "Currency";
        simulate: "focus";
    }
    Select {
        x: 24px;
        y: 120px;
        width: 432px;
        model: ["Euro", "US dollar", "Pound sterling"];
        current-index: 0;
        label: "Currency";
        enabled: false;
