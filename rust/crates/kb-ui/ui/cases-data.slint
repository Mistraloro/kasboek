// 500,000 rows from a `PagedModel`: scroll with the wheel, click, Shift-click, the keys; the numbers are in the README.
export component CaseDataTableLive inherits CaseFrame {
    width: 760px;
    height: 420px;
    Card {
        x: 24px;
        y: 24px;
        width: 712px;
        height: 372px;
        DataTable {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            label: "Transactions";
            rows: TableDemo.rows;
            columns: TableDemo.columns;
            selected-count: TableDemo.selected-count;
            selection-rev: TableDemo.selection-rev;
            cursor <=> TableDemo.cursor;
            scroll-y <=> TableDemo.scroll-y;
            row-actions: [{ text: "Edit" }, { text: "Duplicate" }, { text: "Delete", danger: true, divider: true }];
            is-selected(i) => {
                TableDemo.is-selected(i)
            }
            select(i, shift, toggle) => {
                TableDemo.select(i, shift, toggle);
            }
            select-all(on) => {
                TableDemo.select-all(on);
            }
            activated(i) => {
                TableDemo.last-event = "activate " + i;
            }
            row-action(i, a) => {
                TableDemo.last-event = "action " + i + " " + a;
            }
            layout-requested(w) => {
                TableDemo.layout-requested(w);
            }
        }
    }
}

component MenuCase inherits CaseFrame {
    in property <[MenuItemData]> items;
    in property <string> button-text;
    in property <length> menu-width: 224px;
    width: 640px;
    height: 280px;
    // The popup of a real click on the button; the list beside it is the same thing drawn in place.
    Button {
        x: 24px;
        y: 24px;
        text: root.button-text;
        clicked => {
            menu.open-at(self.x, self.y + self.height + 4px);
        }
    }
    menu := ContextMenu {
        label: root.button-text;
        items: root.items;
        menu-width: root.menu-width;
    }
    MenuList {
        x: 344px;
        y: 24px;
        width: root.menu-width;
        height: self.preferred-height;
        items: root.items;
        hl: 1;
    }
}

export component CaseMenu inherits MenuCase {
    button-text: "Row actions";
    items: [{ text: "Edit" }, { text: "Split" }, { text: "Make recurring" }, { text: "Create rule from this row", disabled: true }, { text: "Delete", danger: true, divider: true }];
}

export component CaseMenuDe inherits MenuCase {
    button-text: "Zeilenaktionen";
    menu-width: 256px;
    items: [{ text: "Bearbeiten" }, { text: "Buchung aufteilen" }, { text: "Als wiederkehrende Zahlung speichern" }, { text: "Regel aus dieser Zeile erstellen", disabled: true }, { text: "Endgültig löschen", danger: true, divider: true }];
}

export component CaseTextArea inherits CaseFrame {
    width: 480px;
    height: 420px;
    Field {
        x: 24px;
        y: 24px;
        width: 432px;
        label: "Note";
        hint: "Only you can see it.";
        TextArea {
            label: "Note";
            rows: 3;
            text: "Rent for March, paid late because the bank was closed on Monday. The landlord agreed to waive the fee, see the e-mail of the fourth.";
        }
    }
    Field {
        x: 24px;
        y: 160px;
        width: 432px;
        label: "Description";
        error: "Write at least a few words.";
        TextArea {
            label: "Description";
            rows: 3;
            placeholder: "What was this for?";
            invalid: true;
        }
    }
    TextArea {
        x: 24px;
        y: 304px;
        width: 208px;
        rows: 2;
        label: "Focused";
        text: "Focused";
        simulate: "focus";
    }
    TextArea {
        x: 248px;
        y: 304px;
        width: 208px;
        rows: 2;
        label: "Disabled";
        text: "Disabled";
        enabled: false;
    }
}

