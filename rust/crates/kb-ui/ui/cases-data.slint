// Gallery cases of batch U1: DataTable, Menu, TextArea, AmountInput, FormDialog, toast with an action. Each has an
// English case and a German one with the long labels (`-de`); light and dark come from `Theme.dark`.
import { Theme } from "theme.slint";
import { Label } from "base.slint";
import { Button } from "button.slint";
import { Card } from "surface.slint";
import { Field, Input, TextArea, AmountInput } from "form.slint";
import { Select } from "overlay.slint";
import { FormDialog, ToastHost } from "dialog.slint";
import { DataTable, TableColumn, TableRowData } from "table.slint";
import { ContextMenu, MenuList, MenuItemData } from "menu.slint";

component CaseFrame inherits Rectangle {
    background: Theme.bg;
}

// What the live table case reads and calls: Rust (`kb_ui::demo::wire`) owns the rows (a `PagedModel` over 500,000
// fake transactions), the selection and the column widths.
export global TableDemo {
    in property <[TableRowData]> rows;
    in property <[TableColumn]> columns;
    in property <int> selected-count;
    in property <int> selection-rev;
    in-out property <int> cursor: -1;
    in-out property <length> scroll-y;
    // What the table did last ("select 5 shift", "activate 3", "action 3 1").
    in-out property <string> last-event;
    pure callback is-selected(int) -> bool;
    callback select(int, bool, bool);
    callback select-all(bool);
    callback layout-requested(length);
}

export component CaseDataTable inherits CaseFrame {
    width: 760px;
    height: 360px;
    Card {
        x: 24px;
        y: 24px;
        width: 712px;
        height: 312px;
        DataTable {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            label: "Transactions";
            simulate: "focus";
            cursor: 2;
            selected-count: 2;
            columns: [{ title: "Date", width: 110px }, { title: "Description", width: 290px }, { title: "Category", width: 140px }, { title: "Amount", width: 120px, numeric: true }];
            rows: [
                { cells: ["05/03/2026", "Supermarket", "Groceries", "-42.10"], label: "05/03/2026, Supermarket, Groceries, minus 42.10" },
                { cells: ["04/03/2026", "Salary March", "Income", "2,450.00"], label: "04/03/2026, Salary March, Income, 2,450.00" },
                { cells: ["03/03/2026", "Landlord", "Rent", "-1,150.00"], label: "03/03/2026, Landlord, Rent, minus 1,150.00" },
                { cells: ["02/03/2026", "Water bill", "Utilities", "-18.40"], label: "02/03/2026, Water bill, Utilities, minus 18.40" },
                { cells: ["01/03/2026", "Bakery on the corner of the market square", "Groceries", "-6.80"], label: "01/03/2026, Bakery, Groceries, minus 6.80" },
                { cells: ["28/02/2026", "Train ticket", "Transport", "-23.50"], label: "28/02/2026, Train ticket, Transport, minus 23.50" },
                { cells: ["27/02/2026", "Gym", "Health", "-29.00"], label: "27/02/2026, Gym, Health, minus 29.00" },
            ];
            is-selected(i) => {
                i == 1 || i == 2
            }
        }
    }
}

