component FormCase inherits CaseFrame {
    in property <string> title;
    in property <string> note-label;
    in property <string> amount-label;
    in property <string> category-label;
    in property <string> primary;
    in property <string> secondary;
    in property <string> error;
    in property <bool> busy;
    in property <[string]> categories;
    width: 640px;
    height: 520px;
    Label {
        x: 40px;
        y: 40px;
        text: "Page behind the dialog";
        color: Theme.muted;
    }
    FormDialog {
        open: true;
        demo: true;
        title: root.title;
        primary-text: root.primary;
        secondary-text: root.secondary;
        error: root.error;
        busy: root.busy;
        Field {
            label: root.note-label;
            Input {
                label: root.note-label;
                text: "Rent for March";
            }
        }
        Field {
            label: root.amount-label;
            AmountInput {
                label: root.amount-label;
                text: "1,150.00";
                unit: "EUR";
            }
        }
        Field {
            label: root.category-label;
            Select {
                label: root.category-label;
                model: root.categories;
                current-index: 0;
            }
        }
    }
}

export component CaseFormDialog inherits FormCase {
    title: "Add a transaction";
    note-label: "Description";
    amount-label: "Amount";
    category-label: "Category";
    primary: "Save";
    secondary: "Cancel";
    error: "The amount can't be zero.";
    categories: ["Rent", "Groceries"];
}

