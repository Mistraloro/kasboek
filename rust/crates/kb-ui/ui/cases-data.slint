}

export component CaseToastAction inherits CaseFrame {
    width: 640px;
    height: 240px;
    ToastHost {
        width: parent.width;
        height: parent.height;
        toasts: [{ id: 1, tone: "success", message: "Copied to the clipboard." }];
        action-toasts: [{ id: 2, tone: "success", message: "3 transactions deleted.", action: "Undo" }];
    }
}

