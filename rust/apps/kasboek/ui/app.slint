// The window: Lock, Setup, loading view, welcome or the shell with its pages, over the design system. The screens are bound
// to the globals of state.slint (generated binding lists, kept in step by hand).
import { Theme, Session, ToastHost, ToastItem, UiText, Rules, DateCheck } from "@kb-ui";
import { Tx } from "tx.slint";
import { LockScreen, SetupScreen, LoadingScreen } from "auth.slint";
import { Shell } from "shell.slint";
import { OverviewPage } from "overview.slint";
import { SettingsPage, SettingsState } from "pages.slint";
import { WelcomeScreen, WelcomeState } from "welcome.slint";
import { AssistantPanelState } from "assistant/panel.slint";
import { TransactionsPage, TransactionsState } from "pages/transactions.slint";
import { BudgetsPage, BudgetsState } from "pages/budgets.slint";
import { RecurringPage, RecurringState } from "pages/recurring.slint";
import { GoalsPage, GoalsState } from "pages/goals.slint";
import { YearPage, YearState } from "pages/year.slint";
import { NetworthPage, NetworthState } from "pages/networth.slint";
import { ImportPage, ImportState } from "pages/import.slint";
import { AccountsState } from "pages/settings/accounts.slint";
import { AppearanceState } from "pages/settings/appearance.slint";
import { FormatsState } from "pages/settings/formats.slint";
import { CurrenciesState } from "pages/settings/currencies.slint";
import { Sec } from "pages/settings/security.slint";
import { BackupsState } from "pages/settings/backups.slint";
import { TransferState } from "pages/settings/transfer.slint";
import { SyncState } from "pages/settings/sync.slint";
import { InsightsState } from "pages/settings/insights.slint";
import { AssistantSettingsState } from "pages/settings/assistant.slint";
import { MemoryState } from "pages/settings/memory.slint";
import { AboutState } from "pages/settings/about.slint";
import { Lock, SetupState, Loading, ShellState, Ov, Recovery, Totp } from "state.slint";
export { Theme, Session, UiText, Rules, DateCheck, Tx, ToastItem, Lock, SetupState, Loading, ShellState, Ov, Recovery, Totp }
// The global of every page, section and panel (each is defined in the file of its page).
export { Sec, SettingsState, WelcomeState, AssistantPanelState, TransactionsState, BudgetsState, RecurringState, GoalsState, YearState, NetworthState, ImportState }
export { AccountsState, AppearanceState, FormatsState, CurrenciesState, BackupsState, TransferState, SyncState, InsightsState, AssistantSettingsState, MemoryState, AboutState }
export { AlertRow, TipRow, AccountRow, RuleRow, QrRun } from "state.slint";
export { CategoryBar, MonthDatum } from "@kb-ui";

export component App inherits Window {
    // "lock" | "setup" | "loading" | "welcome" | "shell".
    in-out property <string> screen: "lock";
    in property <bool> dark: false;
    in property <string> window-title: "Kasboek";
    // Window and taskbar icon (assets/icons, tools/make-app-icon.py); one size for all uses, the 64 px one is the weight-800 K.
    icon: @image-url("../assets/icons/icon-64.png");
    in property <[ToastItem]> toasts;
    callback dismiss-toast(int);

    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 640px;
    min-height: 480px;
    title: root.window-title;
    background: Theme.bg;
    default-font-family: Theme.sans;
    default-font-size: Theme.fs-body;
    init => {
        Theme.dark = root.dark;
    }
    changed dark => {
        Theme.dark = root.dark;
    }

    if root.screen == "lock": lock := LockScreen {
        width: parent.width;
        height: parent.height;
        mode: Lock.mode;
        device-kind: Lock.device-kind;
        device-name: Lock.device-name;
        body: Lock.body;
        error: Lock.error;
        throttle: Lock.throttle;
        remembered-note: Lock.remembered-note;
        need-code: Lock.need-code;
        cant-open: Lock.cant-open;
        busy: Lock.busy;
        erase-word: Lock.erase-word;
        view <=> Lock.view;
        password <=> Lock.password;
        code <=> Lock.code;
        unlock(a0, a1, a2) => {
            Lock.unlock(a0, a1, a2);
        }
        recover(a0) => {
            Lock.recover(a0);
        }
        erase() => {
            Lock.erase();
        }
        retry() => {
            Lock.retry();
        }
    }
    if root.screen == "setup": setup := SetupScreen {
        width: parent.width;
        height: parent.height;
        step <=> SetupState.step;
        body: SetupState.body;
        device-kind: SetupState.device-kind;
        device-title: SetupState.device-title;
        device-note: SetupState.device-note;
        device-enabled: SetupState.device-enabled;
        busy: SetupState.busy;
        error: SetupState.error;
        recovery-key-top: Recovery.key-top;
        recovery-key-bottom: Recovery.key-bottom;
        strength: SetupState.strength;
        strength-text: SetupState.strength-text;
        rules: SetupState.rules;
        password-a <=> SetupState.password-a;
        password-b <=> SetupState.password-b;
        saved <=> Recovery.saved;
        recovery-check <=> Recovery.check;
        recovery-ok: Recovery.ok;
        totp-state: Totp.state;
        totp-secret: Totp.secret;
        totp-runs: Totp.runs;
        totp-modules: Totp.modules;
        totp-error: Totp.error;
        totp-busy: Totp.busy;
        totp-code <=> Totp.code;
        recovery-edited(a0, a1) => {
            Recovery.edited(a0, a1);
        }
        recovery-done() => {
            Recovery.done();
        }
        totp-enable(a0) => {
            Totp.enable(a0);
        }
        password-edited(a0) => {
            SetupState.password-edited(a0);
        }
        create-password(a0) => {
            SetupState.create-password(a0);
        }
        create-device() => {
            SetupState.create-device();
        }
        finished() => {
            SetupState.finished();
        }
    }
    if root.screen == "loading": LoadingScreen {
        width: parent.width;
        height: parent.height;
        step-text: Loading.step-text;
        value: Loading.value;
    }
    if root.screen == "shell": shell := Shell {
        width: parent.width;
        height: parent.height;
        page <=> ShellState.page;
        assistant-open <=> ShellState.assistant-open;
        caption-inset: ShellState.caption-inset;
        sidebar-top: ShellState.sidebar-top;
        version-text: ShellState.version-text;
        lock => {
            ShellState.lock();
        }
        go(p) => {
            ShellState.go(p);
        }
        about => {
            SettingsState.tab = 5;
            ShellState.about();
        }
        if ShellState.page == "overview": OverviewPage {
        title: Ov.title;
        month-label: Ov.month-label;
        year <=> Ov.year;
        month <=> Ov.month;
        today-year: Ov.today-year;
        today-month: Ov.today-month;
        month-names: Ov.month-names;
        show-review: Ov.show-review;
        review-text: Ov.review-text;
        alerts: Ov.alerts;
        income-label: Ov.income-label;
        income: Ov.income;
        spending-label: Ov.spending-label;
        spending: Ov.spending;
        left-label: Ov.left-label;
        left: Ov.left;
        left-tone: Ov.left-tone;
        left-hint: Ov.left-hint;
        summary-error: Ov.summary-error;
        accounts-error: Ov.accounts-error;
        tips-visible: Ov.tips-visible;
        tips-collapsed <=> Ov.tips-collapsed;
        tips-show-get: Ov.tips-show-get;
        tips-get-text: Ov.tips-get-text;
        tips: Ov.tips;
        tips-more: Ov.tips-more;
        tips-empty: Ov.tips-empty;
        tips-error: Ov.tips-error;
        sent-text: Ov.sent-text;
        tips-has-sent: Ov.tips-has-sent;
        sent-open <=> Ov.sent-open;
        unconverted-text: Ov.unconverted-text;
        unconverted-hint: Ov.unconverted-hint;
        uncategorized-text: Ov.uncategorized-text;
        uncategorized-action: Ov.uncategorized-action;
        category-description: Ov.category-description;
        categories: Ov.categories;
        category-top: Ov.category-top;
        categories-empty-title: Ov.categories-empty-title;
        categories-empty-body: Ov.categories-empty-body;
        accounts-title: Ov.accounts-title;
        accounts: Ov.accounts;
        eye-label: Ov.eye-label;
        trend-title: Ov.trend-title;
        trend-description: Ov.trend-description;
        months: Ov.months;
        month-top: Ov.month-top;
        trend-summary: Ov.trend-summary;
        income-legend: Ov.income-legend;
        spending-legend: Ov.spending-legend;
        month-changed(a0, a1) => {
            Ov.month-changed(a0, a1);
        }
        review() => {
            Ov.review();
        }
        tip-feedback(a0, a1) => {
            Ov.tip-feedback(a0, a1);
        }
        toggle-tips() => {
            Ov.toggle-tips();
        }
        show-all() => {
            Ov.show-all();
        }
        get-tips() => {
            Ov.get-tips();
        }
            go(p) => {
                ShellState.go(p);
            }
        }
        if ShellState.page == "transactions": TransactionsPage {
            width: shell.content-width;
            height: shell.content-height;
        }
        if ShellState.page == "budgets": BudgetsPage {
            width: shell.content-width;
            height: shell.content-height;
        }
        if ShellState.page == "recurring": RecurringPage {
            width: shell.content-width;
            height: shell.content-height;
        }
        if ShellState.page == "goals": GoalsPage {
            width: shell.content-width;
            height: shell.content-height;
        }
        if ShellState.page == "year": YearPage {
            width: shell.content-width;
            height: shell.content-height;
        }
        if ShellState.page == "networth": NetworthPage {
            width: shell.content-width;
            height: shell.content-height;
        }
        if ShellState.page == "import": ImportPage {
            width: shell.content-width;
            height: shell.content-height;
        }
        if ShellState.page == "settings": SettingsPage {
            width: shell.content-width;
            height: shell.content-height;
        }
    }
    if root.screen == "welcome": WelcomeScreen {
        width: parent.width;
        height: parent.height;
    }
    ToastHost {
        toasts: root.toasts;
        dismissed(id) => {
            root.dismiss-toast(id);
        }
    }
}
