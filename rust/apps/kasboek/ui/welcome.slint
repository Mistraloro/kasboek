// The welcome screen with the tour (Welcome.tsx): a stub until it is ported (the global is the screen's own).
import { Theme, Card, EmptyState, Icons } from "@kb-ui";
import { Tx } from "tx.slint";

export global WelcomeState {
    in property <string> heading;
    in property <string> body;
}

export component WelcomeScreen inherits Rectangle {
    background: Theme.bg;
    Card {
        x: (parent.width - self.width) / 2;
        y: 64px;
        width: min(560px, parent.width - 80px);
        height: empty.preferred-height + 2px;
        empty := EmptyState {
            icon: Icons.circle-dashed;
            title: WelcomeState.heading;
            body: WelcomeState.body;
        }
    }
}
