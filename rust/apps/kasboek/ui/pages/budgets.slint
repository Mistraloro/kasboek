// Budgets page: a stub until it is ported (the global is the page's own; the page batch replaces both).
import { PlaceholderPage } from "../page.slint";
import { Tx } from "../tx.slint";

export global BudgetsState {
    in property <string> heading;
    in property <string> body;
}

export component BudgetsPage inherits PlaceholderPage {
    title: Tx.tr("nav.budgets");
    heading: BudgetsState.heading;
    body: BudgetsState.body;
}
