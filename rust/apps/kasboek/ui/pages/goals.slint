// Goals page: a stub until it is ported (the global is the page's own; the page batch replaces both).
import { PlaceholderPage } from "../page.slint";
import { Tx } from "../tx.slint";

export global GoalsState {
    in property <string> heading;
    in property <string> body;
}

export component GoalsPage inherits PlaceholderPage {
    title: Tx.tr("nav.goals");
    heading: GoalsState.heading;
    body: GoalsState.body;
}
