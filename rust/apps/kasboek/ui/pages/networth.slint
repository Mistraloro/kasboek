// Networth page: a stub until it is ported (the global is the page's own; the page batch replaces both).
import { PlaceholderPage } from "../page.slint";
import { Tx } from "../tx.slint";

export global NetworthState {
    in property <string> heading;
    in property <string> body;
}

export component NetworthPage inherits PlaceholderPage {
    title: Tx.tr("nav.networth");
    heading: NetworthState.heading;
    body: NetworthState.body;
}
