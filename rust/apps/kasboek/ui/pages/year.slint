// Year page: a stub until it is ported (the global is the page's own; the page batch replaces both).
import { PlaceholderPage } from "../page.slint";
import { Tx } from "../tx.slint";

export global YearState {
    in property <string> heading;
    in property <string> body;
}

export component YearPage inherits PlaceholderPage {
    title: Tx.tr("nav.year");
    heading: YearState.heading;
    body: YearState.body;
}
