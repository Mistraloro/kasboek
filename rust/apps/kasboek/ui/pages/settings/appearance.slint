// Settings -> Appearance: a stub until it is ported (the global is the section's own; the page batch replaces both).
import { SectionStub } from "../../page.slint";
import { Tx } from "../../tx.slint";

export global AppearanceState {
    in property <string> body;
}

export component AppearanceSection inherits SectionStub {
    title: Tx.tr("settings.appearance");
    body: AppearanceState.body;
}
