// Settings -> Sync: a stub until it is ported (the global is the section's own; the page batch replaces both).
import { SectionStub } from "../../page.slint";
import { Tx } from "../../tx.slint";

export global SyncState {
    in property <string> body;
}

export component SyncSection inherits SectionStub {
    title: Tx.tr("sync.title");
    body: SyncState.body;
}
