// Import page: a stub until it is ported (the global is the page's own; the page batch replaces both).
import { PlaceholderPage } from "../page.slint";
import { Tx } from "../tx.slint";

export global ImportState {
    in property <string> heading;
    in property <string> body;
}

export component ImportPage inherits PlaceholderPage {
    title: Tx.tr("nav.import");
    heading: ImportState.heading;
    body: ImportState.body;
}
