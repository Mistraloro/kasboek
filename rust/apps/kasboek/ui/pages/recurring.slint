// Recurring page: a stub until it is ported (the global is the page's own; the page batch replaces both).
import { PlaceholderPage } from "../page.slint";
import { Tx } from "../tx.slint";

export global RecurringState {
    in property <string> heading;
    in property <string> body;
}

export component RecurringPage inherits PlaceholderPage {
    title: Tx.tr("nav.recurring");
    heading: RecurringState.heading;
    body: RecurringState.body;
}
