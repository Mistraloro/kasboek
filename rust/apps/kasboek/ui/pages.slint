// The Settings page (Settings.tsx): header, the tabs and the sections of the tab. Every section is a file of its own in
// pages/settings/ with its own global; this file only places them. The tab is `SettingsState.tab`, so that a link elsewhere
// (the version under Lock) can open one. The page scrolls like the Overview.
import { Theme, Label, PageHeader, Scrollbar, PressTarget } from "@kb-ui";
import { Tx } from "tx.slint";
import { AppearanceSection } from "pages/settings/appearance.slint";
import { FormatsSection } from "pages/settings/formats.slint";
import { CurrenciesSection } from "pages/settings/currencies.slint";
import { InsightsSection } from "pages/settings/insights.slint";
import { AccountsSection } from "pages/settings/accounts.slint";
import { SecuritySection } from "pages/settings/security.slint";
import { BackupsSection } from "pages/settings/backups.slint";
import { SyncSection } from "pages/settings/sync.slint";
import { TransferSection } from "pages/settings/transfer.slint";
import { AssistantSettingsSection } from "pages/settings/assistant.slint";
import { MemorySection } from "pages/settings/memory.slint";
import { AboutSection } from "pages/settings/about.slint";

export global SettingsState {
    // 0 general, 1 accounts, 2 security, 3 data (backups & sync), 4 assistant, 5 about: the order of `SETTINGS_TABS`.
    in-out property <int> tab: 0;
}

// One tab of the strip, as `Tabs` in kb-ui draws it (kb-ui does not export `Tabs` yet; U1 does, and then this goes).
component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback chosen();
    height: 38px;
    width: lbl.preferred-width + 24px;
    lbl := Label {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        height: 20px;
        text: root.text;
        font-weight: 500;
        lh: 20px;
        color: root.selected ? Theme.accent : tgt.hovered ? Theme.text : Theme.muted;
        horizontal-alignment: center;
        accessible-role: none;
    }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.selected ? Theme.accent : transparent;
    }
    tgt := PressTarget {
        label: root.text;
        description: root.selected ? "current tab" : "";
        ring-radius: 8px;
        activated => {
            root.chosen();
        }
    }
}

export component SettingsPage inherits Rectangle {
    property <length> content-w: min(944px, root.width - 80px);
    property <[string]> tabs: [Tx.tr("settings.tab.general"), Tx.tr("settings.tab.accounts"), Tx.tr("settings.tab.security"), Tx.tr("settings.tab.data"), Tx.tr("settings.tab.assistant"), Tx.tr("settings.tab.about")];
    background: Theme.bg;

    flick := Flickable {
        width: parent.width - 10px;
        height: parent.height;
        content-height: page.preferred-height + 16px + 64px;
        interactive: false;
        page := VerticalLayout {
            x: (parent.width - root.content-w) / 2;
            y: 14px;
            width: root.content-w;
            spacing: 16px;
            PageHeader {
                title: Tx.tr("settings.title");
            }
            Rectangle {
                height: 38px;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    accessible-role: tab-list;
                    accessible-label: Tx.tr("settings.title");
                    for t[i] in root.tabs: TabButton {
                        text: t;
                        selected: SettingsState.tab == i;
                        chosen => {
                            SettingsState.tab = i;
                        }
                    }
                }
            }
            if SettingsState.tab == 0: AppearanceSection { }
            if SettingsState.tab == 0: FormatsSection { }
            if SettingsState.tab == 0: CurrenciesSection { }
            if SettingsState.tab == 0: InsightsSection { }
            if SettingsState.tab == 1: AccountsSection { }
            if SettingsState.tab == 2: SecuritySection { }
            if SettingsState.tab == 3: BackupsSection { }
            if SettingsState.tab == 3: SyncSection { }
            if SettingsState.tab == 3: TransferSection { }
            if SettingsState.tab == 4: AssistantSettingsSection { }
            if SettingsState.tab == 4: MemorySection { }
            if SettingsState.tab == 5: AboutSection { }
        }
    }
    Scrollbar {
        x: parent.width - self.width;
        height: parent.height;
        content-height: flick.content-height;
        visible-height: flick.height;
        content-y <=> flick.content-y;
    }
}
