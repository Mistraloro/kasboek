// Lock screen: src/renderer/src/pages/auth/Lock.tsx + AuthLayout.tsx (password mode and Windows Hello mode).
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { Button, Field, PasswordInput, PlainInput } from "widgets.slint";

export component Mark inherits Image {
    // The Kasboek mark (assets/brand/mark.svg); 520x624 viewBox scaled to `size` wide.
    in property <length> size: 20px;
    source: @image-url("../assets/icons/mark.svg");
    width: size;
    height: size * 624 / 520;
    colorize: Theme.accent;
}

export component LockScreen inherits Rectangle {
    // "password" or "device" (Windows Hello).
    in property <string> mode: "password";
    in property <string> device-label: "Windows Hello";
    in-out property <string> password;
    callback unlock(string);
    // Spike D: pressing the device button asks the OS (Windows Hello / Touch ID); the answer is shown as text.
    callback device-pressed();
    in property <string> device-result;
    in property <bool> device-busy: false;
    in property <bool> typing: false;
    in property <string> typing-label;
    in-out property <string> typing-text;
    background: Theme.bg;

    property <bool> device: mode == "device";
    // Height of the wrapped body text under the title: one line is the DOM's 19.5px exactly (the measured height
    // of a line is a little different), two or more lines are measured from the text.
    property <length> body-h: body.preferred-height < 24px ? 19.5px : body.preferred-height;

    // AuthLayout: 44px drag strip, then the card centered in the rest (pb-16), max-w-sm = 384px.
    Rectangle {
        y: 44px;
        height: parent.height - 44px - 64px;
        card := VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: min(384px, root.width - 48px);
                    // Logo row: mb-8, 24px serif semibold, gap-2.5, line height 36px.
                    HorizontalLayout {
                        height: 36px;
                        alignment: center;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Mark { size: 20px; }
                        }
                        Text {
                            text: Strings.app-name;
                            font-family: Theme.serif;
                            font-weight: 600;
                            font-size: 24px;
                            letter-spacing: -0.24px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { height: 32px; }
                    // AuthCard: rounded-xl border bg-surface p-6.
                    Rectangle {
                        background: Theme.surface;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 1px + 24px + 27.5px + (root.device ? 6px + root.body-h : 0px) + 20px + (root.device ? 36px : 113.5px) + 20px + 19.5px + 24px + 1px;

                        Text {
                            x: 25px;
                            y: 25px;
                            width: parent.width - 50px;
                            height: 27.5px;
                            text: Strings.unlock-title;
                            font-family: Theme.serif;
                            font-weight: 500;
                            font-size: 22px;
                            color: Theme.text;
                            vertical-alignment: center;
                            accessible-role: text;
                        }
                        // Always present so that its wrapped height can be measured; hidden in password mode.
                        body := Text {
                            visible: root.device;
                            x: 25px;
                            y: 25px + 27.5px + 6px;
                            width: parent.width - 50px;
                            height: root.device ? root.body-h : 0px;
                            text: Strings.unlock-body;
                            font-family: Theme.sans;
                            font-size: 13px;
                            color: Theme.muted;
                            wrap: word-wrap;
                            line-height-factor: 1.2397;
                            vertical-alignment: center;
                        }
                        form := Rectangle {
                            x: 25px;
                            y: 25px + 27.5px + (root.device ? 6px + root.body-h : 0px) + 20px;
                            width: parent.width - 50px;
                            height: root.device ? 36px : 113.5px;

                            if !root.device: Field {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                label: Strings.password;
                                PasswordInput {
                                    x: 0px;
                                    width: parent.width;
                                    y: 19.5px + 6px;
                                    text <=> root.password;
                                    label: Strings.password;
                                    eye-label: Strings.hold-to-show;
                                    force-focus-look: true;
                                }
                            }
                            Button {
                                x: 0px;
                                y: root.device ? 0px : 61.5px + 16px;
                                width: parent.width;
                                variant: "primary";
                                text: root.device ? Strings.unlock-with : Strings.unlock-button;
                                has-icon: true;
                                icon: root.device ? @image-url("../assets/icons/scan-face.svg") : @image-url("../assets/icons/lock.svg");
                                enabled: root.device ? !root.device-busy : root.password != "";
                                clicked => {
                                    if (root.device) {
                                        root.device-pressed();
                                    } else {
                                        root.unlock(root.password);
                                    }
                                }
                            }
                        }
                        // Forgot password? / Erase data (mt-5, text-[13px]).
                        Text {
                            x: 25px;
                            y: form.y + form.height + 20px;
                            height: 19.5px;
                            text: Strings.forgot;
                            font-family: Theme.sans;
                            font-weight: 500;
                            font-size: 13px;
                            color: Theme.accent;
                            vertical-alignment: center;
                            accessible-role: button;
                            accessible-label: self.text;
                        }
                        Text {
                            x: parent.width - 25px - self.width;
                            y: form.y + form.height + 20px;
                            height: 19.5px;
                            text: Strings.erase-link;
                            font-family: Theme.sans;
                            font-size: 13px;
                            color: Theme.muted;
                            vertical-alignment: center;
                            accessible-role: button;
                            accessible-label: self.text;
                        }
                    }
                }
            }
        }
    }

    // Spike D: result of the device prompt and the typing test, under the card at the bottom of the window.
    if root.device-result != "" || root.typing: VerticalLayout {
        width: min(384px, root.width - 48px);
        x: (root.width - self.width) / 2;
        y: root.height - self.preferred-height - 16px;
        spacing: 8px;
        if root.device-result != "": Text {
            text: root.device-result;
            font-family: Theme.sans;
            font-size: 13px;
            color: Theme.text;
            wrap: word-wrap;
            horizontal-alignment: center;
            accessible-role: text;
        }
        if root.typing: Field {
            label: root.typing-label;
            PlainInput {
                y: 19.5px + 6px;
                text <=> root.typing-text;
                label: root.typing-label;
            }
        }
        if root.typing: Text {
            text: root.typing-text == "" ? "" : "\u{2192} " + root.typing-text;
            font-family: Theme.sans;
            font-size: 20px;
            color: Theme.text;
            wrap: word-wrap;
            accessible-role: text;
        }
    }
}
