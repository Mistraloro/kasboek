import { Theme } from "theme.slint";
import { Startup } from "widgets.slint";
import { Strings } from "strings.slint";
import { LockScreen } from "lock.slint";
import { OverviewScreen, CategoryRow, Step, MonthBar } from "overview.slint";
export { Strings, Theme, Startup, CategoryRow, Step, MonthBar }

export component App inherits Window {
    // "lock-password" | "lock-hello" | "overview"
    in property <string> screen: "lock-password";
    in property <string> income;
    in property <string> spending;
    in property <string> left;
    in property <string> left-hint;
    in property <[CategoryRow]> categories;
    in property <[Step]> steps;
    in property <[MonthBar]> months;
    in-out property <length> scroll: 0px;
    callback unlock(string);
    // Spike D: the device button (Windows Hello or Touch ID), its result text, and the typing test field.
    callback device-pressed();
    callback forgot-pressed();
    callback erase-pressed();
    in-out property <string> device-result;
    in-out property <bool> device-busy: false;
    in property <bool> typing: false;
    in property <string> typing-label;
    in-out property <string> typing-text;

    preferred-width: 1280px;
    preferred-height: 820px;
    title: "Kasboek";
    background: Theme.bg;
    default-font-family: Theme.sans;
    default-font-size: 14px;

    if root.screen == "lock-password" || root.screen == "lock-hello": LockScreen {
        mode: root.screen == "lock-hello" ? "device" : "password";
        unlock(p) => {
            root.unlock(p);
        }
        device-pressed => {
            root.device-pressed();
        }
        forgot-pressed => {
            root.forgot-pressed();
        }
        erase-pressed => {
            root.erase-pressed();
        }
        device-result <=> root.device-result;
        device-busy: root.device-busy;
        typing: root.typing;
        typing-label: root.typing-label;
        typing-text <=> root.typing-text;
    }
    if root.screen == "overview": OverviewScreen {
        income: root.income;
        spending: root.spending;
        left: root.left;
        left-hint: root.left-hint;
        categories: root.categories;
        steps: root.steps;
        months: root.months;
        scroll <=> root.scroll;
    }
}
